# Reference photos are local-only (large/private), but the ground-truth tests.txt is
# tracked — PhotoDetectionTest reads it as the canonical recognition ground truth.
/photos/*
!/photos/tests.txt

# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
release/

# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio / IntelliJ
*.iml
.idea/
.idea/workspace.xml
.idea/tasks.xml
.idea/gradle.xml
.idea/assetWizardSettings.xml
.idea/dictionaries
.idea/libraries
.idea/caches
.idea/modules.xml
.idea/navEditor.xml
captures/

# NDK
.externalNativeBuild/
.cxx/

# Keystore files (do not commit signing keys)
*.jks
*.keystore

# Google Services (may contain API keys)
google-services.json

# Android Profiling
*.hprof

# macOS
.DS_Store

# Kotlin
.kotlin/

# Python (local tooling used to prototype/validate detection)
.venv/
__pycache__/

# Local prototyping scratch output
scratch_*/

# Raw on-device data pull (DB + full-res roll JPEGs); benchmark fixtures live in androidTest/assets/dbphotos
/device-pull/

# Local data: device backup + generated training dataset (large binaries)
backup/
dataset/

# Trained ONNX models are dropped in by hand (see app/src/main/assets/README-model.txt), not versioned
app/src/main/assets/*.onnx
